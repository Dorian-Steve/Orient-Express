generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["views"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ===== USER MANAGEMENT =====
model User {
    id               String   @id @default(cuid())
    email            String   @unique @db.VarChar(255)
    firstName        String?  @db.VarChar(255)
    lastName         String?  @db.VarChar(255)
    imageUrl         String?  @db.VarChar(255)
    schoolId         String   @unique @db.VarChar(255)
    role             UserRole @default(STUDENT)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt
    passwordHash     String?  @db.VarChar(255)
    profileCompleted Boolean  @default(false)

    studentProfile    StudentProfile?
    advisorProfile    AdvisorProfile?
    adminProfile      AdminProfile?
    notifications     Notification[]
    testResults       TestResult[]
    recommendations   Recommendation[]
    favoritePrograms  FavoriteProgram[]
    appointments      Appointment[]
    internshipMatches InternshipMatch[]
    jobMatches        JobMatch[]

    @@map("users")
}

model ValidSchoolId {
    id        Int      @id @default(autoincrement())
    schoolId  String   @unique @db.VarChar(255)
    userRole  UserRole
    isUsed    Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("valid_school_ids")
}

enum UserRole {
    STUDENT
    ADVISOR
    ADMIN
}

// ===== STUDENT PROFILES =====
model StudentProfile {
    id     String @id @default(cuid())
    userId String @unique @db.VarChar(255)
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    studentId             String?          @unique @db.VarChar(255)
    phoneNumber           String?          @db.VarChar(20)
    dateOfBirth           DateTime?
    gender                Gender?
    nationality           String?          @db.VarChar(100)
    address               String?          @db.VarChar(255)
    currentLevel          AcademicLevel?
    currentProgram        String?          @db.VarChar(255)
    currentSpecialization String?          @db.VarChar(255)
    enrollmentYear        Int?
    gpa                   Float?
    previousEducation     String?          @db.VarChar(255)
    baccalaureateType     String?          @db.VarChar(100)
    baccalaureateGrade    String?          @db.VarChar(50)
    mathsGrade            Float?
    physicsGrade          Float?
    chemistryGrade        Float?
    frenchGrade           Float?
    englishGrade          Float?
    careerGoals           String?          @db.VarChar(500)
    preferredSectors      String[]
    workEnvironmentPref   WorkEnvironment?
    geographicConstraints String?          @db.VarChar(255)
    familyConstraints     String?          @db.VarChar(255)
    personalValues        String[]

    profileCompleted  Boolean  @default(false)
    lastProfileUpdate DateTime @default(now())

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    academicForms   AcademicForm[]
    aspirationForms AspirationForm[]

    @@map("student_profiles")
}

enum Gender {
    MALE
    FEMALE
}

enum AcademicLevel {
    BTS1
    BTS2
    LICENSE1
    LICENSE2
    LICENSE3
    MASTER1
    MASTER2
    PHD
}

enum WorkEnvironment {
    OFFICE
    FIELD
    REMOTE
    MIXED
    LABORATORY
    FACTORY
    STARTUP
    LARGE_COMPANY
    HOSPITAL
    SCHOOL
}

// ===== OTHER PROFILES =====
model AdvisorProfile {
    id     String @id @default(cuid())
    userId String @unique @db.VarChar(255)
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    departmentId String?     @db.VarChar(255)
    department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

    specialties String[]
    yearsExp    Int?
    bio         String?  @db.VarChar(1000)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    appointments Appointment[]

    @@map("advisor_profiles")
}

model AdminProfile {
    id     String @id @default(cuid())
    userId String @unique @db.VarChar(255)
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    permissions String[]
    department  String?  @db.VarChar(255)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("admin_profiles")
}

// ===== UNIVERSITY STRUCTURE (NEW MODELS) =====
model Mention {
    id          String       @id @default(cuid())
    name        String       @unique @db.VarChar(255)
    shortName   String       @unique @db.VarChar(50)
    description String?      @db.VarChar(1000)
    departments Department[]
    programs    Program[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("mentions")
}

model Department {
    id          String  @id @default(cuid())
    name        String  @unique @db.VarChar(255)
    description String? @db.VarChar(1000)
    mentionId   String  @db.VarChar(255)
    mention     Mention @relation(fields: [mentionId], references: [id], onDelete: Cascade)

    programs Program[]
    advisors AdvisorProfile[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("departments")
}

// ===== ACADEMIC PROGRAMS =====
model Program {
    id          String        @id @default(cuid())
    code        String        @unique @db.VarChar(50)
    name        String        @db.VarChar(255)
    shortName   String?       @db.VarChar(50)
    description String?       @db.VarChar(1000)
    level       AcademicLevel
    duration    Int

    departmentId String?     @db.VarChar(255)
    department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

    mentionId String?  @db.VarChar(255)
    mention   Mention? @relation(fields: [mentionId], references: [id], onDelete: SetNull)

    prerequisites  String[]
    minGpaRequired Float?
    maxCapacity    Int?

    objectives      String?  @db.VarChar(1000)
    skillsDeveloped String[]
    coursework      String?  @db.VarChar(1000)
    careerProspects String[]
    averageSalary   Float?
    employmentRate  Float?

    isActive        Boolean @default(true)
    applicationOpen Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    specializations    Specialization[]
    recommendations    Recommendation[]
    favoritePrograms   FavoriteProgram[]
    internships        Internship[]
    jobs               Job[]
    alumniTestimonials AlumniTestimonial[]

    @@map("programs")
}

model Specialization {
    id        String  @id @default(cuid())
    programId String  @db.VarChar(255)
    program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

    name         String   @db.VarChar(255)
    description  String?  @db.VarChar(1000)
    requirements String[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("specializations")
}

// ===== ASSESSMENT FORMS =====
model AcademicForm {
    id        String         @id @default(cuid())
    studentId String         @db.VarChar(255)
    student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

    currentLevel          AcademicLevel
    previousGrades        Json
    academicStrengths     String[]
    academicWeaknesses    String[]
    favoriteSubjects      String[]
    leastFavoriteSubjects String[]

    learningStyle         LearningStyle?
    preferredTeachingMode TeachingMode?
    studyHabits           String?        @db.VarChar(1000)
    shortTermGoals        String?        @db.VarChar(1000)
    longTermGoals         String?        @db.VarChar(1000)
    isCompleted           Boolean        @default(false)
    completedAt           DateTime?
    createdAt             DateTime       @default(now())
    updatedAt             DateTime       @updatedAt

    @@map("academic_forms")
}

enum LearningStyle {
    VISUAL
    AUDITORY
    KINESTHETIC
    READING_WRITING
    MIXED
}

enum TeachingMode {
    TRADITIONAL_CLASSROOM
    ONLINE_LEARNING
    HYBRID
    PRACTICAL_WORKSHOPS
    PROJECT_BASED
}

model AspirationForm {
    id        String         @id @default(cuid())
    studentId String         @db.VarChar(255)
    student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

    dreamJob            String?          @db.VarChar(255)
    preferredIndustries String[]
    workEnvironmentPref WorkEnvironment?
    salaryExpectations  SalaryRange?
    workLifeBalance     Int?

    importantValues      String[]
    leadershipInterest   Boolean  @default(false)
    entrepreneurialGoals Boolean  @default(false)
    internationalCareer  Boolean  @default(false)

    geographicFlexibility Boolean @default(true)
    familyConstraints     String? @db.VarChar(255)
    physicalLimitations   String? @db.VarChar(255)

    primaryMotivations String[]
    roleModels         String?  @db.VarChar(255)
    inspirationalStory String?  @db.VarChar(1000)

    isCompleted Boolean   @default(false)
    completedAt DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@map("aspiration_forms")
}

enum SalaryRange {
    BELOW_500K
    RANGE_500K_1M
    RANGE_1M_2M
    RANGE_2M_5M
    ABOVE_5M
    NOT_IMPORTANT
}

// ===== ASSESSMENT TESTS =====
model Test {
    id          String       @id @default(cuid())
    name        String       @db.VarChar(255)
    description String?      @db.VarChar(1000)
    type        TestType
    category    TestCategory

    questions    Json
    timeLimit    Int?
    passingScore Float?
    maxAttempts  Int    @default(3)

    isActive   Boolean    @default(true)
    difficulty Difficulty @default(MEDIUM)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    testResults TestResult[]

    @@map("tests")
}

enum TestType {
    PERSONALITY
    APTITUDE
    LOGICAL_REASONING
    CREATIVE_THINKING
    TECHNICAL_SKILLS
    LANGUAGE_PROFICIENCY
    CAREER_INTEREST
    PSYCHOLOGICAL
}

enum TestCategory {
    CORE_ASSESSMENT
    SUPPLEMENTARY
    DIAGNOSTIC
    VALIDATION
}

enum Difficulty {
    EASY
    MEDIUM
    HARD
    EXPERT
}

model TestResult {
    id     String @id @default(cuid())
    userId String @db.VarChar(255)
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    testId String @db.VarChar(255)
    test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

    score      Float
    maxScore   Float
    percentage Float
    responses  Json
    analysis   Json

    timeSpent     Int
    startedAt     DateTime
    completedAt   DateTime?
    isCompleted   Boolean   @default(false)
    attemptNumber Int       @default(1)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, testId, attemptNumber])
    @@map("test_results")
}

// ===== RECOMMENDATION SYSTEM =====
model Recommendation {
    id        String  @id @default(cuid())
    userId    String  @db.VarChar(255)
    user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    programId String  @db.VarChar(255)
    program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

    score           Float
    confidence      Float
    reasoning       String[]
    strengths       String[]
    challenges      String[]
    recommendations String[]

    algorithmVersion String @default("1.0") @db.VarChar(50)
    criteriaWeights  Json

    userFeedback RecommendationFeedback?
    isBookmarked Boolean                 @default(false)
    viewedAt     DateTime?
    createdAt    DateTime                @default(now())
    updatedAt    DateTime                @updatedAt

    @@unique([userId, programId])
    @@map("recommendations")
}

enum RecommendationFeedback {
    VERY_HELPFUL
    HELPFUL
    NEUTRAL
    NOT_HELPFUL
    MISLEADING
}

// ===== FAVORITES AND BOOKMARKS =====
model FavoriteProgram {
    id        String  @id @default(cuid())
    userId    String  @db.VarChar(255)
    user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    programId String  @db.VarChar(255)
    program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

    notes    String? @db.VarChar(1000)
    priority Int     @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, programId])
    @@map("favorite_programs")
}

// ===== INTERNSHIPS AND CAREER OPPORTUNITIES =====
model Internship {
    id        String   @id @default(cuid())
    programId String?  @db.VarChar(255)
    program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)

    // Company Information
    companyName    String       @db.VarChar(255) // Company name, mandatory
    companyLogo    String?      @db.VarChar(255) // Optional URL for company logo
    companyWebsite String?      @db.VarChar(255) // Optional company website URL
    companySize    CompanySize? // Optional company size using enum
    industry       String       @db.VarChar(255) // Industry of the company, mandatory

    // Position Details
    title            String   @db.VarChar(255) // Internship title, mandatory
    description      String   @db.Text // Detailed description of the internship, mandatory
    requirements     String[] // JSON array of requirements, mandatory
    responsibilities String[] // JSON array of responsibilities, mandatory
    skills           String[] // JSON array of required skills, mandatory

    // Practical Information
    location            String    @db.VarChar(255) // Internship location, mandatory
    duration            Int // Duration in months, mandatory
    stipend             Float? // Optional stipend amount
    isRemote            Boolean   @default(false) // Indicates if the internship is remote
    startDate           DateTime? // Optional start date
    applicationDeadline DateTime? // Optional application deadline

    // Contact Information
    contactEmail   String?  @db.VarChar(255) // Optional contact email
    contactPhone   String?  @db.VarChar(20) // Optional contact phone number
    contactPerson  String?  @db.VarChar(255) // Optional contact person name
    // Status
    isActive       Boolean  @default(true) // Indicates if the internship listing is active
    spotsAvailable Int? // Optional number of spots available
    createdAt      DateTime @default(now()) // Timestamp for creation
    updatedAt      DateTime @updatedAt // Timestamp for last update

    // Relations
    internshipMatches InternshipMatch[] // One-to-many relation with InternshipMatch

    @@map("internships") // Maps to the "internships" table
}

// Enum for company size
enum CompanySize {
    STARTUP // 1-10 employees
    SMALL // 11-50 employees
    MEDIUM // 51-200 employees
    LARGE // 201-1000 employees
    ENTERPRISE // 1000+ employees
}

model InternshipMatch {
    id           String     @id @default(cuid())
    userId       String     @db.VarChar(255) // Foreign key to User, mandatory
    user         User       @relation(fields: [userId], references: [id], onDelete: Cascade) // Relation to User, cascade delete
    internshipId String     @db.VarChar(255) // Foreign key to Internship, mandatory
    internship   Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade) // Relation to Internship, cascade delete

    // Match Information
    matchScore Float // Compatibility score (0-100), mandatory
    status     ApplicationStatus @default(INTERESTED) // Application status using enum
    appliedAt  DateTime? // Optional timestamp when the user applied
    // User Notes
    notes      String?           @db.VarChar(1000) // Optional notes by the user
    createdAt  DateTime          @default(now()) // Timestamp for creation
    updatedAt  DateTime          @updatedAt // Timestamp for last update

    @@unique([userId, internshipId]) // Ensures unique match entry for a user and internship
    @@map("internship_matches") // Maps to the "internship_matches" table
}

model Job {
    id        String   @id @default(cuid())
    programId String?  @db.VarChar(255) // Optional foreign key to Program (if linked to a specific program)
    program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull) // Relation to Program, set null on delete

    // Company Information
    companyName    String       @db.VarChar(255) // Company name, mandatory
    companyLogo    String?      @db.VarChar(255) // Optional URL for company logo
    companyWebsite String?      @db.VarChar(255) // Optional company website URL
    companySize    CompanySize? // Optional company size
    industry       String       @db.VarChar(255) // Industry of the company, mandatory

    // Position Details
    title            String   @db.VarChar(255) // Job title, mandatory
    description      String   @db.Text // Detailed description of the job, mandatory
    requirements     String[] // JSON array of requirements, mandatory
    responsibilities String[] // JSON array of responsibilities, mandatory
    skills           String[] // JSON array of required skills, mandatory

    // Practical Information
    location            String         @db.VarChar(255) // Job location, mandatory
    employmentType      EmploymentType @default(FULL_TIME) // Type of employment using enum
    salary              Float? // Optional salary amount
    salaryRange         SalaryRange? // Optional salary range using enum
    isRemote            Boolean        @default(false) // Indicates if the job is remote
    startDate           DateTime? // Optional start date
    applicationDeadline DateTime? // Optional application deadline

    // Contact Information
    contactEmail   String?  @db.VarChar(255) // Optional contact email
    contactPhone   String?  @db.VarChar(20) // Optional contact phone number
    contactPerson  String?  @db.VarChar(255) // Optional contact person name
    // Status
    isActive       Boolean  @default(true) // Indicates if the job listing is active
    spotsAvailable Int? // Optional number of spots available
    createdAt      DateTime @default(now()) // Timestamp for creation
    updatedAt      DateTime @updatedAt // Timestamp for last update

    // Relations
    jobMatches JobMatch[] // One-to-many relation with JobMatch

    @@map("jobs") // Maps to the "jobs" table
}

// Enum for employment types
enum EmploymentType {
    FULL_TIME
    PART_TIME
    CONTRACT
    TEMPORARY
    INTERNSHIP
    FREELANCE
}

model JobMatch {
    id     String @id @default(cuid())
    userId String @db.VarChar(255) // Foreign key to User, mandatory
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) // Relation to User, cascade delete
    jobId  String @db.VarChar(255) // Foreign key to Job, mandatory
    job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade) // Relation to Job, cascade delete

    // Match Information
    matchScore Float // Compatibility score (0-100), mandatory
    status     ApplicationStatus @default(INTERESTED) // Application status using enum
    appliedAt  DateTime? // Optional timestamp when the user applied
    // User Notes
    notes      String?           @db.VarChar(1000) // Optional notes by the user
    createdAt  DateTime          @default(now()) // Timestamp for creation
    updatedAt  DateTime          @updatedAt // Timestamp for last update

    @@unique([userId, jobId]) // Ensures unique match entry for a user and job
    @@map("job_matches") // Maps to the "job_matches" table
}

// Enum for application statuses
enum ApplicationStatus {
    INTERESTED
    APPLIED
    INTERVIEW_SCHEDULED
    UNDER_REVIEW
    ACCEPTED
    REJECTED
    WITHDRAWN
    OFFER_PENDING
}

// ===== APPOINTMENTS AND COUNSELING =====
model Appointment {
    id        String          @id @default(cuid())
    studentId String          @db.VarChar(255) // Foreign key to User (student), mandatory
    student   User            @relation(fields: [studentId], references: [id], onDelete: Cascade) // Relation to User, cascade delete
    advisorId String?         @db.VarChar(255) // Optional foreign key to AdvisorProfile
    advisor   AdvisorProfile? @relation(fields: [advisorId], references: [id], onDelete: SetNull) // Relation to AdvisorProfile, set null on delete

    // Appointment Details
    title       String          @db.VarChar(255) // Appointment title, mandatory
    description String?         @db.VarChar(1000) // Optional description
    type        AppointmentType // Type of appointment, mandatory
    mode        MeetingMode     @default(IN_PERSON) // Meeting mode (in-person, video call, etc.)

    // Scheduling
    scheduledAt DateTime // Scheduled date and time, mandatory
    duration    Int      @default(60) // Duration in minutes, default 60
    location    String?  @db.VarChar(255) // Optional physical location
    meetingLink String?  @db.VarChar(255) // Optional link for virtual meetings

    // Status
    status          AppointmentStatus @default(SCHEDULED) // Current status of the appointment
    cancelReason    String?           @db.VarChar(1000) // Optional reason for cancellation
    rescheduleCount Int               @default(0) // Number of times the appointment has been rescheduled

    // Notes
    advisorNotes  String?  @db.VarChar(1000) // Optional notes from the advisor
    studentNotes  String?  @db.VarChar(1000) // Optional notes from the student
    followUpItems String[] // JSON array of follow-up items

    createdAt DateTime @default(now()) // Timestamp for creation
    updatedAt DateTime @updatedAt // Timestamp for last update

    @@map("appointments") // Maps to the "appointments" table
}

// Enum for appointment types
enum AppointmentType {
    ACADEMIC_GUIDANCE
    CAREER_COUNSELING
    PROGRAM_SELECTION
    INTERNSHIP_GUIDANCE
    PERSONAL_DEVELOPMENT
    FOLLOW_UP
    MENTAL_HEALTH
}

// Enum for meeting modes
enum MeetingMode {
    IN_PERSON
    VIDEO_CALL
    PHONE_CALL
    CHAT
}

// Enum for appointment statuses
enum AppointmentStatus {
    SCHEDULED
    CONFIRMED
    IN_PROGRESS
    COMPLETED
    CANCELLED
    NO_SHOW
    RESCHEDULED
}

// ===== NOTIFICATIONS =====
model Notification {
    id     String @id @default(cuid())
    userId String @db.VarChar(255) // Foreign key to User, mandatory
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade) // Relation to User, cascade delete

    // Notification Content
    title    String               @db.VarChar(255) // Notification title, mandatory
    message  String               @db.Text // Notification message content, mandatory
    type     NotificationType // Type of notification, mandatory
    priority NotificationPriority @default(MEDIUM) // Priority of the notification

    // Notification Data
    data      Json? // Additional data for the notification, optional
    actionUrl String? @db.VarChar(255) // URL to navigate when notification is clicked, optional

    // Status
    isRead      Boolean   @default(false) // Indicates if the notification has been read
    readAt      DateTime? // Optional timestamp when the notification was read
    // Delivery
    deliveredAt DateTime? // Optional timestamp when the notification was delivered
    expiresAt   DateTime? // Optional timestamp when the notification expires
    createdAt   DateTime  @default(now()) // Timestamp for creation
    updatedAt   DateTime  @updatedAt // Timestamp for last update

    @@index([userId, isRead]) // Index for efficient querying of unread notifications for a user
    @@map("notifications") // Maps to the "notifications" table
}

// Enum for notification types
enum NotificationType {
    RECOMMENDATION_READY
    APPOINTMENT_REMINDER
    APPLICATION_DEADLINE
    PROGRAM_UPDATE
    TEST_AVAILABLE
    INTERNSHIP_MATCH
    JOB_MATCH
    SYSTEM_ANNOUNCEMENT
    PROFILE_INCOMPLETE
    WELCOME
}

// Enum for notification priority
enum NotificationPriority {
    LOW
    MEDIUM
    HIGH
    URGENT
}

// ===== ALUMNI TESTIMONIALS =====
model AlumniTestimonial {
    id        String  @id @default(cuid()) // Unique ID for the testimonial
    programId String  @db.VarChar(255) // Foreign key to Program, mandatory
    program   Program @relation(fields: [programId], references: [id], onDelete: Cascade) // Relation to Program, cascade delete

    // Alumni Information
    alumniName     String  @db.VarChar(255) // Name of the alumnus, mandatory
    graduationYear Int // Graduation year, mandatory
    currentJob     String? @db.VarChar(255) // Optional current job title
    currentCompany String? @db.VarChar(255) // Optional current company

    // Testimonial Content
    testimonial String  @db.Text // Full testimonial text, mandatory
    advice      String? @db.Text // Optional advice from the alumnus
    rating      Int?    @db.SmallInt // Optional rating (1-5 stars) using SmallInt for efficiency

    // Media
    profileImage String? @db.VarChar(255) // Optional URL for profile image
    videoUrl     String? @db.VarChar(255) // Optional URL for testimonial video

    // Status
    isApproved Boolean @default(false) // Indicates if the testimonial is approved for display
    isFeatured Boolean @default(false) // Indicates if the testimonial is featured

    createdAt DateTime @default(now()) // Timestamp for creation
    updatedAt DateTime @updatedAt // Timestamp for last update

    @@index([programId, isApproved]) // Index for efficient querying of approved testimonials by program
    @@map("alumni_testimonials") // Maps to the "alumni_testimonials" table
}

// ===== SYSTEM CONFIGURATION =====
model SystemConfig {
    id    String @id @default(cuid())
    key   String @unique @db.VarChar(255) // Unique configuration key, mandatory
    value Json // Configuration value, can be any JSON type, mandatory

    description String? @db.VarChar(1000) // Optional description of the configuration
    category    String? @db.VarChar(255) // Optional category for grouping configurations
    isActive    Boolean @default(true) // Indicates if the configuration is active

    createdAt DateTime @default(now()) // Timestamp for creation
    updatedAt DateTime @updatedAt // Timestamp for last update

    @@map("system_config") // Maps to the "system_config" table
}

// ===== ANALYTICS =====
model UserActivity {
    id        String  @id @default(cuid())
    userId    String? @db.VarChar(255) // Optional foreign key to User (if activity is linked to a logged-in user)
    sessionId String? @db.VarChar(255) // Optional session ID for tracking anonymous or logged-out activity

    // Activity Details
    action     String  @db.VarChar(255) // Description of the action performed (e.g., "page_view", "button_click"), mandatory
    resource   String? @db.VarChar(255) // Optional type of resource acted upon (e.g., "program", "test")
    resourceId String? @db.VarChar(255) // Optional ID of the resource acted upon
    metadata   Json? // Optional additional metadata about the action

    // Context
    userAgent String?  @db.VarChar(255) // Optional user agent string from the client
    ipAddress String?  @db.VarChar(45) // Optional IP address of the user (IPv4 or IPv6)
    referrer  String?  @db.VarChar(255) // Optional referrer URL
    createdAt DateTime @default(now()) // Timestamp for when the activity occurred

    @@index([userId, createdAt]) // Index for efficient querying of user activity over time
    @@index([action, createdAt]) // Index for efficient analytics by action type over time
    @@map("user_activities") // Maps to the "user_activities" table
}
